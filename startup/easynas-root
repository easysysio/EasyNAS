#!/usr/bin/perl
#========================================================================
# easynas-root -- the root side of the web interface.
#
# The web interface runs as the unprivileged "easynas" user and reaches root
# only through sudo. The goal is a sudoers rule that allows it this script
# and the other helpers in /easynas/startup (lxc-helper.sh ...), never ALL:
# then a bug in a page can do only what these helpers allow, with the
# arguments they accept, instead of anything at all. (Being allowed sudo on
# tee, sed, systemctl or zypper is the same as being root: they can write any
# file or run any command. So the commands are here, checked, not in sudoers.)
#
# Until every page goes through the helpers, sudoers still says ALL; see
# t/sudo-calls.t for what is left.
#
#   easynas-root service <start|stop|restart|restart-later|reload|enable|disable> <unit>
#       Control one systemd unit: one an installed add-on declares
#       (<service> in /easynas/addons/*.easynas, root's package files) or one
#       of the few the core itself manages. restart-later queues the restart
#       and returns at once (for the web interface restarting itself).
#
#   easynas-root file read <path>
#   easynas-root file write <path>      (the new content on stdin)
#   easynas-root file append <path>     (the lines to add on stdin)
#       Read or change one of the config files the root daemons read (smb.conf,
#       /etc/exports, rsyncd.conf, RADIUS clients, DLNA, TFTP). Only the lines
#       a change adds are checked, against what EasyNAS itself writes there
#       (a share's path under /mnt, its read-only flag ...): those files can
#       otherwise make the daemon run anything as root (Samba's "root preexec",
#       rsync's "pre-xfer exec", FreeRADIUS back-ticks). Lines already in the
#       file stay as they are, so hand edits survive. A write replaces the file
#       in one step (a temporary file renamed over it), keeping its owner and
#       mode.
#
#   easynas-root share-marker write <volume path> <smb|nfs|rsyncd>   (stdin)
#   easynas-root share-marker remove <volume path> <smb|nfs|rsyncd>
#       The share's record inside the volume, <volume>/.easynas/<type>.share
#       (it travels with the data; see rediscover_shares in easynas.pm). The
#       volume's users can write in the volume, so .easynas must be a real
#       directory, never a link somewhere else.
#
#   easynas-root hostname <name>
#       Set the host name: /etc/hostname, /etc/hosts and the running system.
#
# Exit status: 0 done, 1 the command failed, 2 refused (bad arguments).
#
# This file is part of EasyNAS (c) created by Yariv Hakim
#========================================================================
use strict;
use warnings;

$ENV{PATH} = '/usr/sbin:/usr/bin:/sbin:/bin';
delete @ENV{qw(IFS CDPATH ENV BASH_ENV)};

# Where things are; t/easynas-root.t points them elsewhere. (sudo drops the
# environment: the sudoers rule for this script must not allow SETENV.)
my $ADDONS    = $ENV{EASYNAS_ADDONS_DIR} // '/easynas/addons';
my $SYSTEMCTL = $ENV{EASYNAS_SYSTEMCTL}  // '/usr/bin/systemctl';
my $PREFIX    = $ENV{EASYNAS_ROOT_PREFIX} // '';     # prepended to every file path
my $HOSTNAME  = $ENV{EASYNAS_HOSTNAME_CMD} // '/usr/bin/hostname';

# Units the core manages besides the add-ons' own.
my @CORE_UNITS = qw(easynas.service cron.service nmb.service rpcbind.service easynas-tftp.socket);

sub refuse { print STDERR "easynas-root: $_[0]\n"; exit 2 }

# "smb" and "smb.service" are the same unit.
sub unit_name {
  my ($u) = @_;
  return undef unless defined $u && $u =~ /^[A-Za-z0-9][A-Za-z0-9@._-]{0,100}$/;
  return $u =~ /\.(service|socket|timer|target|mount|path)$/ ? $u : "$u.service";
}

sub known_units {
  my %ok = map { $_ => 1 } @CORE_UNITS;
  if (opendir(my $d, $ADDONS)) {
    for my $f (grep { /^[A-Za-z0-9_-]+\.easynas$/ } readdir $d) {
      open(my $fh, '<', "$ADDONS/$f") or next;
      while (<$fh>) {
        next unless m{<service>\s*([^<\s]+)\s*</service>};
        my $u = unit_name($1);
        $ok{$u} = 1 if defined $u;
      }
      close $fh;
    }
    closedir $d;
  }
  return %ok;
}

########## files ##########

use Fcntl qw(:DEFAULT :flock :mode);
use File::Basename qw(dirname basename);

my $MAX_SIZE = 1 << 20;

# A path under /mnt, as a share's path is: /mnt/<fs>[/<volume>[/...]], with
# no ".." and nothing a config file would read as more than a path.
sub mnt_path {
  my ($p) = @_;
  return defined $p && $p =~ m{^/mnt(?:/[A-Za-z0-9_][A-Za-z0-9._-]*)*/?$} && $p !~ m{/\.\.?(?:/|$)};
}
sub user_ok  { my ($u) = @_; return defined $u && $u =~ /^[A-Za-z0-9_][A-Za-z0-9._-]{0,31}$/ && defined getpwnam($u) }
# a group a share may run as: a real one, not root's (gid 0)
sub group_ok {
  my ($g) = @_;
  return 0 unless defined $g && $g =~ /^[A-Za-z0-9_][A-Za-z0-9._-]{0,31}$/;
  my @gr = getgrnam($g);
  return @gr && $gr[2] != 0;
}
sub yes_no   { my ($v) = @_; return defined $v && $v =~ /^(?:yes|no|true|false|0|1)$/i }

# Each checker gets a line the change adds; it returns a reason to refuse it,
# or nothing when the line is fine.

# smb.conf: share sections as samba.pm writes them (share_section).
sub smb_line {
  my ($l) = @_;
  return if $l =~ /^\s*$/ || $l =~ /^\s*[#;]/;
  if ($l =~ /^\s*\[([^\]]*)\]\s*$/) {
    my $n = $1;
    return "a section named \"$n\"" if $n !~ /^[A-Za-z0-9._-]{1,64}$/ || $n =~ /^(?:global|homes|printers)$/i;
    return;
  }
  my ($k, $v) = $l =~ /^\s*([^=]+?)\s*=\s*(.*?)\s*$/ or return "not a parameter";
  $k = lc $k; $k =~ s/\s+/ /g;
  return                                     if $k eq 'path' && mnt_path($v);
  return                                     if $k =~ /^(?:browsable|browseable|guest ok|read only|writable|writeable)$/ && yes_no($v);
  return                                     if $k eq 'force user' && $v eq 'nobody';
  return                                     if $k eq 'force group' && ($v eq 'nobody' || group_ok($v));
  return                                     if $k =~ /^(?:valid users|write list)$/
                                                && $v ne '' && !grep { !(/^@(.+)$/ && group_ok($1)) } split /[\s,]+/, $v;
  return                                     if $k =~ /^vfs objects?$/ && $v eq 'recycle';
  return                                     if $k eq 'recycle:repository' && $v eq 'recycle';
  return                                     if $k =~ /^recycle:(?:touch|keeptree)$/ && yes_no($v);
  return                                     if $k eq 'recycle:exclude_dir' && $v eq 'recycle';
  return                                     if $k eq 'comment' && $v =~ /^[A-Za-z0-9._ -]{0,64}$/;
  return "\"$k = $v\"";
}

# /etc/exports: "<path> *(rw|ro,sync,no_subtree_check)", as nfs.pm writes it.
sub exports_line {
  my ($l) = @_;
  return if $l =~ /^\s*$/ || $l =~ /^\s*#/;
  my ($p, $o) = $l =~ /^(\S+)\s+\*\(([^)]*)\)\s*$/ or return "\"$l\"";
  return "not a path under /mnt: $p" unless mnt_path($p) && $p ne '/mnt' && $p ne '/mnt/';
  return "options \"$o\"" unless $o =~ /^(?:rw|ro),sync,no_subtree_check$/;
  return;
}

# rsyncd.conf: modules as rsyncd.pm writes them.
sub rsyncd_line {
  my ($l) = @_;
  return if $l =~ /^\s*$/ || $l =~ /^\s*#/;
  return if $l =~ /^\[[A-Za-z0-9_-]{1,64}\]$/ && $l !~ /^\[global\]$/i;
  return if $l =~ /^path = (.*)$/ && mnt_path($1);
  return if $l =~ /^read only = (?:yes|no)$/;
  return if $l =~ /^comment = [A-Za-z0-9_-]{1,64}$/;
  return "\"$l\"";
}

# RADIUS clients.conf: client blocks as radius.pm writes them. FreeRADIUS runs
# a back-quoted value, and $INCLUDEs other files, so no ` or $ anywhere.
sub radius_line {
  my ($l) = @_;
  return if $l =~ /^\s*$/ || $l =~ /^\s*#/;
  return "\"$l\"" if $l =~ /[`\$\\'"]/;
  return if $l =~ /^client [A-Za-z0-9_.-]{1,64} \{$/;
  return if $l =~ /^ipaddr = [0-9a-fA-F.:\/]{3,45}$/;
  return if $l =~ /^secret = [!-~]{1,128}$/ && $l !~ /[{}#]/;
  return if $l eq '}';
  return "\"$l\"";
}

# minidlna.conf: the settings dlna.pm changes.
sub dlna_line {
  my ($l) = @_;
  return if $l =~ /^\s*$/ || $l =~ /^\s*#/;
  return if $l =~ /^media_dir=(.*)$/ && mnt_path($1);
  return if $l =~ /^(?:port|notify_interval|max_connections)=\d{1,5}$/;
  return if $l =~ /^friendly_name=[A-Za-z0-9_. -]{1,64}$/;
  return "\"$l\"";
}

# The TFTP settings: the user it serves as and the one directory it serves.
sub tftp_line {
  my ($l) = @_;
  return if $l =~ /^\s*$/ || $l =~ /^\s*#/;
  return if $l =~ /^TFTP_USER=(\S+)$/ && user_ok($1);
  return if $l eq 'TFTP_OPTIONS=';
  return if $l =~ /^TFTP_DIRECTORY=(\S+)\s*$/ && mnt_path($1);
  return "\"$l\"";
}

# path => [checker for added lines, or undef: read only]
my %FILES = (
  '/etc/samba/smb.conf'               => [\&smb_line],
  '/etc/exports'                      => [\&exports_line],
  '/etc/easynas/rsyncd/rsyncd.conf'   => [\&rsyncd_line],
  '/etc/easynas/raddb/clients.conf'   => [\&radius_line],
  '/etc/easynas/minidlna'             => [\&dlna_line],
  '/etc/easynas/tftp'                 => [\&tftp_line],
);

sub slurp_fh { my ($fh) = @_; local $/; my $s = <$fh>; return $s // '' }

# Root's own: owned by the helper's user and writable by nobody else.
sub own_st { my @st = @_; return $st[4] == $> && !(S_IMODE($st[2]) & 022) }

# Every directory between the prefix and $real must be a real directory of
# the helper's user that nobody else can rename things in: writable only by
# its owner, or sticky (like /etc/easynas, root:easynas 1775, where easynas
# makes its own files but can't move root's). Else a directory easynas can
# change could swap a file, or itself, between the checks and the write.
sub safe_dirs {
  my ($real) = @_;
  my $d = $PREFIX;
  my @parts = grep { length } split m{/}, substr(dirname($real), length $PREFIX);
  for my $p (@parts) {
    $d .= "/$p";
    my @st = lstat($d);
    refuse("$d is not a directory") unless @st && S_ISDIR($st[2]);
    refuse("$d is not root's") unless $st[4] == $>;
    refuse("others can change $d") if (S_IMODE($st[2]) & 022) && !(S_IMODE($st[2]) & 01000);
  }
}

# The file's text, '' when it doesn't exist. A link is refused: these files
# are plain files, and a link could point anywhere.
sub read_config {
  my ($real) = @_;
  my @st = lstat($real);
  return '' unless @st;
  refuse("$real is not a plain file") unless S_ISREG($st[2]);
  open(my $fh, '<', $real) or do { print STDERR "easynas-root: $real: $!\n"; exit 1 };
  my $s = slurp_fh($fh);
  close $fh;
  return $s;
}

# Write $text to $real in one step: a new file next to it, then renamed over
# it. The new file is root's (the helper's user) and writable only by root,
# with the old file's group and the rest of its mode (radiusd reads
# clients.conf through its group); the easynas group, from older releases
# that gave easynas these files, becomes root's. A new file is 0644.
sub replace_file {
  my ($real, $text) = @_;
  safe_dirs($real);
  my @st = lstat($real);
  refuse("$real is not a plain file") if @st && !S_ISREG($st[2]);
  my $egid = (split ' ', $))[0];
  my $gid = @st ? $st[5] : $egid;
  my $easynas = getgrnam('easynas');
  $gid = $egid if defined $easynas && $gid == $easynas && $easynas != $egid;
  my ($uid, $mode) = ($>, @st ? S_IMODE($st[2]) & ~022 : 0644);
  my $tmp = dirname($real) . '/.' . basename($real) . ".easynas-root.$$";
  sysopen(my $fh, $tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0600)
    or do { print STDERR "easynas-root: $tmp: $!\n"; exit 1 };
  my $ok = (print $fh $text) && chown($uid, $gid, $fh) && chmod($mode, $fh) && close($fh);
  $ok &&= rename($tmp, $real);
  unless ($ok) { my $e = $!; unlink $tmp; print STDERR "easynas-root: $real: $e\n"; exit 1 }
}

sub stdin_text {
  binmode STDIN;
  my $s = '';
  while (read(STDIN, my $buf, 65536)) {
    $s .= $buf;
    refuse("more than $MAX_SIZE bytes") if length($s) > $MAX_SIZE;
  }
  refuse("not text") if $s =~ /[^\t\n\x20-\x7e\x80-\xff]/;
  return $s;
}

# Every line of $new that $old doesn't have must pass $check.
sub check_added {
  my ($path, $old, $new, $check) = @_;
  my %have;
  $have{$_}++ for split /\n/, $old;
  for my $l (split /\n/, $new) {
    if ($have{$l}) { $have{$l}--; next }
    my $why = $check->($l);
    refuse("$path: EasyNAS does not write $why there") if defined $why;
  }
}

sub file_cmd {
  my ($op, $path) = @_;
  refuse("usage: file read|write|append <path>") unless defined $path && @ARGV == 0;
  my $f = $FILES{$path} or refuse("$path is not a file EasyNAS manages");
  my $real = $PREFIX . $path;
  if ($op eq 'read') { safe_dirs($real); print read_config($real); exit 0 }
  refuse("unknown file action \"$op\"") unless $op eq 'write' || $op eq 'append';
  my $in = stdin_text();
  # one change at a time (each reads the file, then writes it)
  my $lock;
  flock($lock, LOCK_EX) if open($lock, '>>', "$PREFIX/run/easynas-root.lock");
  safe_dirs($real);
  my $old = read_config($real);
  my $new = $op eq 'write' ? $in : $old . ($old eq '' || $old =~ /\n\z/ ? '' : "\n") . $in;
  $new .= "\n" if $new ne '' && $new !~ /\n\z/;
  refuse("more than $MAX_SIZE bytes") if length($new) > $MAX_SIZE;
  # Lines already there may stay -- unless someone else could have put them
  # there: a file that isn't root's alone has every line checked.
  my @st = lstat($real);
  check_added($path, (!@st || own_st(@st)) ? $old : '', $new, $f->[0]);
  replace_file($real, $new) unless $new eq $old;
  exit 0;
}

########## share markers ##########

# <volume>/.easynas, opened without following a link, as a path through
# /proc/self/fd that stays on that directory whatever is renamed meanwhile.
sub marker_dir {
  my ($vol, $create) = @_;
  refuse("not a volume: $vol") unless defined $vol && $vol =~ m{^/mnt/[A-Za-z0-9_][A-Za-z0-9_-]*/[A-Za-z0-9_][A-Za-z0-9._-]*$};
  my $real = $PREFIX . $vol;
  my @v = lstat($real);
  refuse("not a volume: $vol") unless @v && S_ISDIR($v[2]);
  my $d = "$real/.easynas";
  mkdir($d, 0755) if $create && !lstat($d);
  my @st = lstat($d);
  return undef unless @st;
  refuse("$vol/.easynas is not a directory") unless S_ISDIR($st[2]);
  sysopen(my $dh, $d, O_RDONLY | O_NOFOLLOW | O_DIRECTORY) or refuse("$vol/.easynas: $!");
  my @o = stat($dh);
  refuse("$vol/.easynas is not root's") unless $o[4] == $>;
  return ($dh, '/proc/self/fd/' . fileno($dh));
}

sub marker_cmd {
  my ($op, $vol, $type) = @_;
  refuse("usage: share-marker write|remove <volume> <smb|nfs|rsyncd>") unless defined $type && @ARGV == 0;
  refuse("unknown share type \"$type\"") unless $type =~ /^(?:smb|nfs|rsyncd)$/;
  if ($op eq 'write') {
    my $in = stdin_text();
    my ($dh, $dir) = marker_dir($vol, 1);
    refuse("$vol/.easynas could not be made") unless $dh;
    my $tmp = "$dir/.$type.share.$$";
    sysopen(my $fh, $tmp, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0644) or do { print STDERR "easynas-root: $vol: $!\n"; exit 1 };
    my $ok = (print $fh $in) && close($fh) && rename($tmp, "$dir/$type.share");
    unless ($ok) { unlink $tmp; print STDERR "easynas-root: $vol/.easynas/$type.share: $!\n"; exit 1 }
    exit 0;
  }
  if ($op eq 'remove') {
    my ($dh, $dir) = marker_dir($vol, 0);
    exit 0 unless $dh;
    my @st = lstat("$dir/$type.share");
    exit 0 unless @st;
    unlink("$dir/$type.share") or do { print STDERR "easynas-root: $vol/.easynas/$type.share: $!\n"; exit 1 };
    exit 0;
  }
  refuse("unknown share-marker action \"$op\"");
}

########## host name ##########

sub hostname_cmd {
  my ($name) = @_;
  refuse("usage: hostname <name>") unless defined $name && @ARGV == 0;
  my $label = qr/[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?/;
  refuse("bad host name") unless length($name) <= 253 && $name =~ /^$label(?:\.$label)*$/;
  replace_file("$PREFIX/etc/hostname", "$name\n");
  replace_file("$PREFIX/etc/hosts", "############## EasyNAS hosts file ############\n127.0.0.1  localhost $name\n");
  { no warnings 'exec'; exec { $HOSTNAME } $HOSTNAME, $name; }
  print STDERR "easynas-root: $HOSTNAME: $!\n";
  exit 1;
}

my %ACTIONS = map { $_ => 1 } qw(start stop restart restart-later reload enable disable);

my $cmd = shift(@ARGV) // '';
if ($cmd eq 'service') {
  refuse("usage: service <action> <unit>") unless @ARGV == 2;
  my ($action, $unit) = @ARGV;
  refuse("unknown action \"$action\"") unless $ACTIONS{$action};
  my $u = unit_name($unit) // refuse("bad unit name");
  my %ok = known_units();
  refuse("unit $u is not one EasyNAS manages") unless $ok{$u};
  my @run = $action eq 'restart-later' ? ('--no-block', 'restart', $u) : ($action, $u);
  { no warnings 'exec'; exec { $SYSTEMCTL } $SYSTEMCTL, @run; }
  print STDERR "easynas-root: $SYSTEMCTL: $!\n";
  exit 1;
}
if ($cmd eq 'file')         { my @a = splice(@ARGV, 0, 2); file_cmd(@a) }
if ($cmd eq 'share-marker') { my @a = splice(@ARGV, 0, 3); marker_cmd(@a) }
if ($cmd eq 'hostname')     { my @a = splice(@ARGV, 0, 1); hostname_cmd(@a) }

refuse("usage: easynas-root service|file|share-marker|hostname ...");
