% # The frame a NAS user gets around the pages open to them (the file manager,
% # their profile): a title bar with the page, their name (a link to their
% # profile) and a sign-out link, and nothing of the administration interface.
% # Pages stash "home" (where the EasyNAS title leads) and "username".
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>EasyNAS - <%= $TEXT->{$addon->{'description'}} %></title>
        <link href="/css/bootstrap.min.css" rel="stylesheet">
        <link href="/fonts/css/fontawesome.css" rel="stylesheet" />
        <link href="/fonts/css/solid.css" rel="stylesheet" />
        <link href="/fonts/css/v4-font-face.css" rel="stylesheet" />
        <style>
         body { padding-top: 70px; background: #f8f8f8; }
         .navbar-text a { color: #9d9d9d; }
         .navbar-text a:hover { color: #fff; text-decoration: none; }
        </style>
    </head>
    <body>
        <nav class="navbar navbar-inverse navbar-fixed-top" role="navigation">
            <div class="container-fluid">
                <div class="navbar-header">
                    <a class="navbar-brand" href="<%= stash('home') // '/' %>">EasyNAS</a>
                    <p class="navbar-text"><i class="fa <%= $addon->{'icon'} %>"></i> <%= $TEXT->{$addon->{'description'}} %></p>
                </div>
                <p class="navbar-text navbar-right" style="margin-right:15px">
                    <a href="/profile" title="<%= $TEXT->{'user_profile'} || 'User Profile' %>"><i class="fa fa-user fa-fw"></i> <%= $username %></a>
                    &nbsp;&nbsp;<a href="/logout"><i class="fa fa-right-from-bracket fa-fw"></i> <%= $TEXT->{'sign_out'} || 'Sign out' %></a>
                </p>
            </div>
        </nav>
        <div class="container-fluid">
            <%= content %>
        </div>
        <script src="/js/jquery.min.js"></script>
        <script src="/js/bootstrap.min.js"></script>
    </body>
</html>
