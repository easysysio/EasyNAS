% layout 'default';

<div class="row">
 <div class="col-lg-8">
  <div class="panel panel-default">
   <div class="panel-heading"><label><%= ($TEXT->{'lxc_create'}) %></label></div>
   <form role="form" method="post" action="/lxc">
   <input type="hidden" name="action" value="create">
   <div class="panel-body">
    <div class="form-group">
     <label><%= ($TEXT->{'lxc_name'}) %></label>
     <input class="form-control" name="name" required maxlength="64" pattern="[A-Za-z0-9][A-Za-z0-9._\-]*">
    </div>
    <div class="form-group">
     <label><%= ($TEXT->{'lxc_image'} || 'Image') %></label>
% if (keys %$images) {
     <select class="form-control" name="image">
%   foreach my $dist (sort keys %$images) {
      <optgroup label="<%= $dist %>">
%     foreach my $rel (@{$images->{$dist}}) {
       <option value="<%= $dist %>:<%= $rel %>" <%= ($dist eq 'debian' && $rel eq 'trixie') ? 'selected' : '' %>><%= $dist %> <%= $rel %></option>
%     }
      </optgroup>
%   }
     </select>
     <p class="help-block"><%= ($TEXT->{'lxc_image_help'} || 'Downloaded from images.linuxcontainers.org for this machine') %> (<%= $arch %>).</p>
% } else {
     <p class="text-danger"><%= ($TEXT->{'lxc_no_images'} || "Couldn't get the list of images from images.linuxcontainers.org. Is the appliance online?") %></p>
% }
    </div>
    <div class="form-group">
     <label><%= ($TEXT->{'lxc_network'} || 'Network') %></label>
     <div class="radio"><label><input type="radio" name="network" value="nat" checked>
      <b><%= ($TEXT->{'lxc_network_nat'} || 'Private') %></b> &mdash;
      <%= ($TEXT->{'lxc_network_nat_help'} || 'an address on a private network inside the NAS (10.0.3.x). It reaches the internet; other devices on your network cannot reach it.') %></label></div>
     <div class="radio"><label><input type="radio" name="network" value="lan">
      <b><%= ($TEXT->{'lxc_network_lan'} || 'Your network') %></b> &mdash;
      <%= ($TEXT->{'lxc_network_lan_help'} || 'its own address from your router, like another computer on the network. Other devices can reach it; the NAS itself cannot.') %></label></div>
    </div>
    <div class="form-group">
     <label><%= ($TEXT->{'lxc_root_password'} || 'Root password') %></label>
     <input type="password" class="form-control" name="password1" required autocomplete="new-password">
    </div>
    <div class="form-group">
     <label><%= ($TEXT->{'lxc_root_password_again'} || 'Root password again') %></label>
     <input type="password" class="form-control" name="password2" required autocomplete="new-password">
     <p class="help-block"><%= ($TEXT->{'lxc_root_password_help'} || "For signing in to the container as root (for example over SSH, once it is installed). The terminal here doesn't ask for it.") %></p>
    </div>
    <div class="form-group" id="lxc-storage">
     <label><%= ($TEXT->{'lxc_volume'} || 'Volume') %></label>
% if ($storage_vol ne "") {
     <p class="form-control-static"><i class="fa fa-hdd-o"></i> <b><%= $storage_vol %></b></p>
     <p class="help-block"><%= ($TEXT->{'lxc_volume_set_help'} || 'Every container is kept on this volume. To move them all to another one, use Change on the containers page.') %></p>
% } elsif (keys %$volumes) {
     <select class="form-control" name="vol" required>
%   for my $v (sort keys %$volumes) {
      <option value="<%= $v %>"><%= $v %></option>
%   }
     </select>
     <p class="help-block"><%= ($TEXT->{'lxc_volume_help'} || "Containers are kept on a volume (in its lxc folder), so they survive firmware updates, which wipe the system disk. This container and every one after it go here.") %></p>
% } else {
     <p class="text-danger"><%= ($TEXT->{'lxc_no_vol_create'} || 'Containers are kept on a volume, and there is none yet.') %>
      <a href="/volume"><%= ($TEXT->{'lxc_create_vol'} || 'Create a volume first') %></a></p>
% }
    </div>
    <div class="checkbox"><label><input type="checkbox" name="autostart" value="1"> <%= ($TEXT->{'lxc_autostart'} || 'Start at boot') %></label></div>
   </div>
   <div class="panel-footer"><center>
    <button type="submit" class="btn btn-primary" <%= ((keys %$images) && ($storage_vol ne '' || keys %$volumes)) ? '' : 'disabled' %>><%= ($TEXT->{'lxc_create_button'} || 'Create') %></button>
    <a class="btn btn-default" href="/lxc"><%= ($TEXT->{'lxc_cancel'} || 'Cancel') %></a>
   </center></div>
   </form>
  </div>
 </div>
</div>
