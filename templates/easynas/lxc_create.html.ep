% layout 'default';

<div class="row">
 <div class="col-lg-8">
  <div class="panel panel-default">
   <div class="panel-heading"><label><%= ($TEXT->{'lxc_create'}) %></label></div>
   <form role="form" method="post" action="/lxc">
   <input type="hidden" name="action" value="create">
   <div class="panel-body">
% if ($storage_vol eq "") {
    <div class="alert alert-warning">
     <%= ($TEXT->{'lxc_internal_warning'} || 'Containers are kept on the system disk, which a firmware update wipes.') %>
     <a href="?action=storagemenu" class="alert-link"><%= ($TEXT->{'lxc_choose_volume'} || 'Keep them on a volume') %></a>
    </div>
% }
    <div class="form-group">
     <label><%= ($TEXT->{'lxc_name'}) %></label>
     <input class="form-control" name="name" required maxlength="64" pattern="[A-Za-z0-9][A-Za-z0-9._\-]*">
    </div>
    <div class="form-group">
     <label><%= ($TEXT->{'lxc_image'} || 'Image') %></label>
% if (keys %$images) {
     <select class="form-control" name="image">
%   foreach my $dist (sort keys %$images) {
      <optgroup label="<%= $dist %>">
%     foreach my $rel (@{$images->{$dist}}) {
       <option value="<%= $dist %>:<%= $rel %>" <%= ($dist eq 'debian' && $rel eq 'trixie') ? 'selected' : '' %>><%= $dist %> <%= $rel %></option>
%     }
      </optgroup>
%   }
     </select>
     <p class="help-block"><%= ($TEXT->{'lxc_image_help'} || 'Downloaded from images.linuxcontainers.org for this machine') %> (<%= $arch %>).</p>
% } else {
     <p class="text-danger"><%= ($TEXT->{'lxc_no_images'} || "Couldn't get the list of images from images.linuxcontainers.org. Is the appliance online?") %></p>
% }
    </div>
    <div class="form-group">
     <label><%= ($TEXT->{'lxc_network'} || 'Network') %></label>
     <div class="radio"><label><input type="radio" name="network" value="nat" checked>
      <b><%= ($TEXT->{'lxc_network_nat'} || 'Private') %></b> &mdash;
      <%= ($TEXT->{'lxc_network_nat_help'} || 'an address on a private network inside the NAS (10.0.3.x). It reaches the internet; other devices on your network cannot reach it.') %></label></div>
     <div class="radio"><label><input type="radio" name="network" value="lan">
      <b><%= ($TEXT->{'lxc_network_lan'} || 'Your network') %></b> &mdash;
      <%= ($TEXT->{'lxc_network_lan_help'} || 'its own address from your router, like another computer on the network. Other devices can reach it; the NAS itself cannot.') %></label></div>
    </div>
    <div class="checkbox"><label><input type="checkbox" name="autostart" value="1"> <%= ($TEXT->{'lxc_autostart'} || 'Start at boot') %></label></div>
   </div>
   <div class="panel-footer"><center>
    <button type="submit" class="btn btn-primary" <%= (keys %$images) ? '' : 'disabled' %>><%= ($TEXT->{'lxc_create_button'} || 'Create') %></button>
    <a class="btn btn-default" href="/lxc"><%= ($TEXT->{'lxc_cancel'} || 'Cancel') %></a>
   </center></div>
   </form>
  </div>
 </div>
</div>
