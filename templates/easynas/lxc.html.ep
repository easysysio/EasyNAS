% layout 'default';

%if ($result eq "fail"){
<div class="alert alert-danger alert-dismissible">
 <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
 <%= $msg %>
</div>
 %}

 %if ($result eq "success"){
<div class="alert alert-success alert-dismissible">
 <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
 <%= $msg %>
</div>
 %}


<div class="row">
                        <div class="col-lg-12">
    <p class="text-muted"><%= $TEXT->{'about_lxc'} %></p>
                                <!-- /.panel-heading -->
                                    <div class="table-responsive">
                                        <table class="table table-striped table-bordered table-hover" id="dataTables-example">
                                            <thead>
                                                <tr>
						<th></th>
						<th><%= ($TEXT->{'lxc_name'}) %></th>
						<th><%= ($TEXT->{'lxc_state'}) %></th>
						<th><%= ($TEXT->{'lxc_ip'}) %></th>
						<th><%= ($TEXT->{'lxc_action'}) %></th>
                                                </tr>
                                            </thead>
                                            <tbody>
						% foreach my $system (sort keys (%$systems)) {
%   my $running = ($systems->{$system}[1] eq 'RUNNING');
                                                <tr>
                                                    <td><i class="fa fa-desktop fa-2x"></i></td>
						    <td><%= $systems->{$system}[0] %></td>
						    <td><%= $systems->{$system}[1] %></td>
						    <td><%= $systems->{$system}[2] %></td>
						    <td>
% if ($running) {
						     <a href="?action=terminal&name=<%= $system %>" target="_blank" rel="noopener noreferrer" title="<%= ($TEXT->{'lxc_terminal'} || 'Terminal') %>"><i class="fa fa-terminal fa-2x">&nbsp;</i></a>
						     <a href="?action=stop&name=<%= $system %>" title="<%= ($TEXT->{'lxc_stop'} || 'Stop') %>"><i class="fa fa-stop fa-2x"></i></a>
% } else {
						     <a href="?action=start&name=<%= $system %>" title="<%= ($TEXT->{'lxc_start'} || 'Start') %>"><i class="fa fa-play fa-2x"></i></a>
% }
						    </td>
						</tr>
					 	%}
% unless (keys %$systems) {
						<tr><td colspan="5" class="text-muted"><%= ($TEXT->{'lxc_none'} || 'No containers.') %></td></tr>
% }
                                            </tbody>
                                        </table>
                                    </div>
				</div>
				 <br><br><br><br><br><a href="?action=createlxcmenu">[<%= ($TEXT->{'lxc_create'}) %>]</a>
			
