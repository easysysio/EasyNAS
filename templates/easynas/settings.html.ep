% layout 'default';

%if ($result eq "fail"){
<div class="alert alert-danger alert-dismissible">
 <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
 <%= $msg %>
</div>
 %}

 %if ($result eq "success"){
<div class="alert alert-success alert-dismissible">
 <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
 <%= $msg %>
</div>
 %}


<div class="row">
 <div class="col-lg-6">
      <!-- /.panel-heading -->
  <div class="panel panel-default">
   <div class="panel-heading"><%= ($TEXT->{"settings"}) %></div>
    <div class="panel-body">
     <ul class="nav nav-tabs">
      <li class="active"><a href="#tabs-1" data-toggle="tab"><%= ($TEXT->{'settings'}) %></a></li>
      <li><a href="#tabs-2" data-toggle="tab"><%= ($TEXT->{'settings_date_time'}) %></a></li>
      <li><a href="#tabs-3" data-toggle="tab"><%= ($TEXT->{'settings_cert'}) %></a></li>
      <li><a href="#tabs-4" data-toggle="tab"><%= ($TEXT->{'settings_repo'}) %></a></li>
     </ul>
     <div class="tab-content">
     <div class="tab-pane fade in active" id="tabs-1">
      <BR><BR>
      <form role="form" method="post" action="/settings">
       <input type=hidden name="action" value="changesettings">
       <div class="form-group">
        <label><%= ($TEXT->{'settings_hostname'}) %></label>
        <input class="form-control" value="<%= $hostname %>" name="hostname">
       </div>
       <div class="form-group">
        <label><%= ($TEXT->{'settings_port'}) %></label>
        <input class="form-control" value="<%= $port %>" name="port">
       </div>
       <div class="form-group">
        <label><%= ($TEXT->{'settings_snapshots'} || 'Upgrade snapshots to keep') %></label>
        <input class="form-control" type="number" min="1" max="100" value="<%= $snapshots %>" name="snapshots"
               placeholder="<%= ($TEXT->{'settings_snapshots_na'} || 'not available (no snapshots)') %>">
        <span class="help-block"><small><%= ($TEXT->{'settings_snapshots_help'} || 'How many pre/post upgrade snapshots to retain before old ones are removed.') %></small></span>
       </div>
       <div class="panel-footer">
        <center>
         <button type="submit" class="btn btn-default"><%= ($TEXT->{'settings_save'}) %></button>
         <button type="reset" class="btn btn-default"><%= ($TEXT->{'settings_reset'}) %></button> 
        </center>
       </div>
      </form>
     </div><!-- end of #tab1 -->
     <div class="tab-pane fade" id="tabs-2">
      <br><br>
      <form role="form" method="post" action="/settings">
       <input type="hidden" name="action" value="setdate">
       <div class="form-group">
        <label><%= ($TEXT->{'settings_date'} || 'Date') %></label>
        <input class="form-control" type="date" name="date" value="<%= $today %>">
       </div>
       <div class="form-group">
        <label><%= ($TEXT->{'settings_time'} || 'Time') %></label>
        <input class="form-control" type="time" name="time" value="<%= $now %>">
       </div>
       <span class="help-block"><small><%= ($TEXT->{'settings_date_help'} || 'Manual set is for when NTP is not in use; NTP will otherwise re-sync the clock.') %></small></span>
       <div class="panel-footer">
        <center>
         <button type="submit" class="btn btn-default"><%= ($TEXT->{'settings_save'}) %></button>
        </center>
       </div>
      </form>
     </div><!-- end of #tab2 -->
     <div class="tab-pane fade" id="tabs-3">
      <br><br>
      % if ($cert_info) {
      <label><%= ($TEXT->{'settings_cert_current'} || 'Current certificate') %></label>
      <pre><%= $cert_info %></pre>
      % }
      <form role="form" method="post" action="settings" enctype="multipart/form-data">
       <input type="hidden" name="action" value="upload_crt">
       <div class="form-group">
        <label><%= ($TEXT->{'settings_cert_file'} || 'Certificate (PEM)') %></label>
        <input class="form-control" type="file" name="cert" accept=".pem,.crt,.cert">
       </div>
       <div class="form-group">
        <label><%= ($TEXT->{'settings_key_file'} || 'Private key (PEM, optional)') %></label>
        <input class="form-control" type="file" name="key" accept=".pem,.key">
       </div>
       <span class="help-block"><small><%= ($TEXT->{'settings_cert_help'} || 'Upload a matching certificate and key. The web server restarts to apply them.') %></small></span>
       <div class="panel-footer">
        <center>
         <button type="submit" class="btn btn-default"><%= ($TEXT->{'settings_save'}) %></button>
        </center>
       </div>
      </form>
     </div><!-- end of #tab3 -->
     <div class="tab-pane fade" id="tabs-4">
      <br><br>
      <form role="form" method="post" action="settings"
            onsubmit="var t=this.querySelector('input[name=channel]:checked'); return !t || t.value !== 'testing' || confirm(<%= Mojo::JSON::to_json($TEXT->{'settings_channel_testing_confirm'} || 'Testing builds are previews and may have bugs. Switch this appliance to the testing channel?') %>);">
       <input type="hidden" name="action" value="setchannel">
       <div class="form-group">
        <label><%= ($TEXT->{'settings_channel'} || 'Update channel') %></label>
        <div class="radio">
         <label>
          <input type="radio" name="channel" value="stable" <%= $channel eq 'stable' ? 'checked' : '' %>>
          <b><%= ($TEXT->{'settings_channel_stable'} || 'Stable') %></b> &mdash;
          <%= ($TEXT->{'settings_channel_stable_help'} || 'tested releases; recommended') %>
         </label>
        </div>
        <div class="radio">
         <label>
          <input type="radio" name="channel" value="testing" <%= $channel eq 'testing' ? 'checked' : '' %>>
          <b><%= ($TEXT->{'settings_channel_testing'} || 'Testing') %></b> &mdash;
          <%= ($TEXT->{'settings_channel_testing_help'} || 'preview builds with the newest changes; may have bugs') %>
         </label>
        </div>
        <span class="help-block"><small><%= ($TEXT->{'settings_channel_help'} || 'Where EasyNAS and its add-ons are updated from. Changing the channel installs nothing; updates from the new channel show up under Add-ons. Going back to Stable keeps the newer testing versions until Stable catches up.') %></small></span>
       </div>
       <div class="panel-footer">
        <center>
         <button type="submit" class="btn btn-default"><%= ($TEXT->{'settings_save'}) %></button>
        </center>
       </div>
      </form>
      <br>
      <label><%= ($TEXT->{'settings_repos'} || 'Configured repositories') %></label>
      <div class="table-responsive">
       <table class="table table-condensed table-striped">
        <thead>
         <tr>
          <th><%= ($TEXT->{'settings_repo_name'} || 'Name') %></th>
          <th><%= ($TEXT->{'settings_repo_url'} || 'URL') %></th>
          <th><%= ($TEXT->{'settings_repo_enabled'} || 'Enabled') %></th>
         </tr>
        </thead>
        <tbody>
        % for my $r (@$repos) {
         <tr>
          <td><%= $r->{alias} %></td>
          <td style="word-break:break-all"><small><%= $r->{url} %></small></td>
          <td><i class="fa <%= $r->{enabled} ? 'fa-check text-success' : 'fa-xmark text-muted' %>"></i></td>
         </tr>
        % }
        % unless (@$repos) {
         <tr><td colspan="3"><%= ($TEXT->{'settings_repos_none'} || 'No repositories found.') %></td></tr>
        % }
        </tbody>
       </table>
      </div>
     </div><!-- end of #tab4 -->
   </div><!-- end of .tab_container -->
</div></div></div></div>

