% # The signed-in account's own page. Administrators see it in the normal
% # layout, NAS users in their bare frame (layouts/user.html.ep).
% if ($is_admin) { layout 'default'; } else { layout 'user'; }

% if ($result eq "fail") {
<div class="alert alert-danger alert-dismissible">
 <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
 <%= $msg %>
</div>
% }
% if ($result eq "success") {
<div class="alert alert-success alert-dismissible">
 <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
 <%= $msg %>
</div>
% }

<div class="row">
 <div class="col-lg-6 col-md-8">
  <div class="panel panel-default">
   <div class="panel-heading">
    <i class="fa fa-key fa-fw"></i> <b><%= $TEXT->{'profile_change_password'} || 'Change password' %></b>
   </div>
   <form role="form" method="post" action="/profile" autocomplete="off">
    <input type="hidden" name="action" value="changepassword">
    <div class="panel-body">
     <div class="form-group">
      <label><%= $TEXT->{'users_name'} || 'User Name' %></label>
      <input class="form-control" value="<%= $username %>" disabled>
      <input type="hidden" name="username" value="<%= $username %>" autocomplete="username">
     </div>
     <div class="form-group">
      <label for="pf-current"><%= $TEXT->{'profile_current'} || 'Current password' %></label>
      <input type="password" class="form-control" id="pf-current" name="current" autocomplete="current-password" required>
     </div>
     <div class="form-group">
      <label for="pf-new"><%= $TEXT->{'profile_new'} || 'New password' %></label>
      <input type="password" class="form-control" id="pf-new" name="password1" autocomplete="new-password" required>
     </div>
     <div class="form-group">
      <label for="pf-again"><%= $TEXT->{'profile_retype'} || 'Retype the new password' %></label>
      <input type="password" class="form-control" id="pf-again" name="password2" autocomplete="new-password" required>
     </div>
% if (!$web_admin) {
     <p class="help-block"><%= $TEXT->{'profile_shares_note'} || 'This is also your password for the file shares (Samba, SSH, FTP).' %></p>
% }
    </div>
    <div class="panel-footer">
     <button type="submit" class="btn btn-primary"><%= $TEXT->{'profile_change_password'} || 'Change password' %></button>
    </div>
   </form>
  </div>
 </div>
</div>
