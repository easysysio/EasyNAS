% layout 'default';

<div class="row">
 <div class="col-lg-10">
  <div class="panel panel-default">
   <div class="panel-heading">
    <label><%= ($TEXT->{'users_create'}) %></label>
   </div>
   <div class="panel-body">
        <form role="form" method="post" action="/users">
         <input type=hidden name="action" value="createuser">
         <div class="form-group">
          <label><%= ($TEXT->{'users_name'}) %></label>
          <input class="form-control" name="name">
         </div>
         <div class="form-group">
          <label><%= ($TEXT->{'users_desc'}) %></label>
	  <input class="form-control" name="desc">
         </div>
         <div class="form-group">
          <label><%= ($TEXT->{'users_password'}) %></label>
	  <input type="password" class="form-control" name="password1">
         </div>
	 <div class="form-group">
          <label><%= ($TEXT->{'users_password_retype'}) %></label>
          <input type="password" class="form-control" name="password2">
         </div>
	 <div class="form-group">
          <label><%= ($TEXT->{'users_groups'}) %></label>
	  <BR>
	  % foreach my $group (sort keys (%$groups)) {
          <input type="checkbox" name="groups" value="<%= $group %>">
	  <label><%= $group %></label>
	  <BR>
          %}
         </div>
	 <div class="form-group">
	  <div class="checkbox">
	   <label><input type="checkbox" name="admin" value="1"> <b><%= ($TEXT->{'users_admin'} || 'Administrator') %></b></label>
	  </div>
	  <p class="help-block"><%= ($TEXT->{'users_admin_help'} || 'Can sign in to this web interface with this account and change every setting, like the admin account.') %></p>
	 </div>
        </div>
      <div class="panel-footer">
       <center>
        <button type="submit" class="btn btn-default"><%= ($TEXT->{'users_add'}) %></button>
        <button type="reset" class="btn btn-default"><%= ($TEXT->{'users_reset'}) %></button>
       </center>
       </form>
      </div>
    </div>
 </div>
</div>
